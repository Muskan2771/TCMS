{
  "name": "smartpro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "/",
  "scripts": {
    "dev": "env-cmd -f .env.development vite --host 0.0.0.0",
    "dev:prod": "env-cmd -f .env.production vite --host 0.0.0.0",
    "build:dev": "npm run generate-meta-tag && env-cmd -f .env.development vite build --base=./",
    "build:prod": "npm run generate-meta-tag && env-cmd -f .env.production vite build --base=./",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "jest",
    "analyze": "source-map-explorer dist/**/*.js",
    "generate-meta-tag": "node ./node_modules/react-cache-buster/dist/generate-meta-tag.js"
  },
  "dependencies": {
    "@mui/x-charts": "^7.16.0",
    "axios": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "framer-motion": "^12.0.6",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.462.0",
    "maven": "^5.0.0",
    "react": "^18.3.1",
    "react-datepicker": "^7.5.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-router-dom": "^6.24.0",
    "react-toastify": "^10.0.5",
    "recharts": "^2.13.3",
    "smartpro": "file:",
    "sweetalert2": "^11.12.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.31.6",
    "vite-plugin-pack-war": "^1.0.1",
    "vite-plugin-pwa": "^0.21.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.9",
    "@babel/preset-env": "^7.24.8",
    "@babel/preset-react": "^7.24.7",
    "@eslint/js": "^9.20.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "babel-jest": "^29.7.0",
    "env-cmd": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^15.14.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.38",
    "prettier": "^3.4.2",
    "react-cache-buster": "^0.1.8",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  }
}
